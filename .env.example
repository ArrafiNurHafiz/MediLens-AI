# MediLens AI - Environment Configuration Template
# Copy this file to .env.local and fill in the values

# AI Provider Configuration
# 1. Google Gemini Native API (Recommended for Cloud Deployment)
GEMINI_API_KEY=

# 2. 9Router / OpenAI Compatible Local Gateway (Optional for Local Development)
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=ag/gemini-3.8-flash-high
